# Copy this file to .env and fill it in. Restart the server after changing it.

# Your site's public address (used for links in emails)
SITE_URL=http://localhost:5050

# Email - example uses Gmail. You need a Gmail "App password"
# (Google Account > Security > 2-Step Verification > App passwords), NOT your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-letter-app-password
MAIL_FROM=Nova <you@gmail.com>
