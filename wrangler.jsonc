// Cloudflare Workers config for Nova. See README.md → "Deploying to Cloudflare".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nova",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // CSS, JS, the landing page and EmulatorJS. Anything not found here goes to the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  // Users, games, polls, updates, chat history. No id needed: `wrangler deploy` creates the
  // database the first time, and the Worker creates the tables on its first request.
  "d1_databases": [
    { "binding": "DB", "database_name": "nova", "migrations_dir": "migrations" }
  ],

  // Uploaded single-file HTML games. Also created automatically on the first deploy.
  "kv_namespaces": [
    { "binding": "GAME_FILES" }
  ],

  // Lets the Worker import migrations/*.sql as text (it sets up its own tables).
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],

  // Live Pro chat.
  "durable_objects": {
    "bindings": [{ "name": "CHAT", "class_name": "ChatRoom" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChatRoom"] }
  ],

  "observability": { "enabled": true },

  // Optional settings. Secrets (SECRET_KEY, OWNER_SETUP_CODE, RESEND_API_KEY) are optional too and are set
  // in the dashboard (Worker → Settings → Variables and Secrets) or with `npx wrangler secret put NAME`.
  "vars": {
    "SITE_URL": "",
    "MAIL_FROM": ""
  }
}
